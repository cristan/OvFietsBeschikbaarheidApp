    <string name="about_lock_text_2">.</string>

    <string name="about_app_title">About this app</string>
    <string name="about_app_text_1">This app wasn't developed by NS and is open source: the source code is\u0020</string>
    <string name="about_app_text_1_on_github">on GitHub</string>
    <string name="about_app_text_2">. The data comes from OpenOV. The map icon was made by\u0020</string>
    <string name="about_app_text_3">brgfx on Freepik</string>
    <string name="about_app_text_4">.</string>
    <string name="about_app_text_5">Feedback? Happy with the app? Leave a review\u0020</string>
    <string name="about_app_text_6">on Google Play</string>
