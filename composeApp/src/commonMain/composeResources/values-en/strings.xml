    <string name="about_ov_fiets_title">Renting an OV-fiets</string>
    <string name="about_ov_fiets_text_1_with_amount">Rent an OV-fiets at more than 300 locations for €%1$s per 24 hours.\u0020</string>
    <string name="about_ov_fiets_text_1_without_amount">Rent an OV-fiets at more than 300 locations.\u0020</string>
    <string name="about_ov_fiets_text_2">All you need is a free subscription on your OV-chipkaart, which you can activate at\u0020</string>
    <string name="about_ov_fiets_url">https://ns.nl/en/ov-fiets</string>
    <string name="about_ov_fiets_url_text">ns.nl/en/ov-fiets</string>
    <string name="about_ov_fiets_text_3">.\n\nYou can rent up to 2 bikes with 1 subscription.</string>

    <string name="about_lock_title">Using the lock</string>
    <string name="about_lock_text_1">At most locations, your OV-chipkaart is the key. You'll find instructions on the luggage rack or at\u0020</string>
